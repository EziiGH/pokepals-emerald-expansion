+// Pokepals multi-ability system: dedicated Abilities page.
+static const u8 sText_AbilitiesPage_MainLabel[] = _("Ability");
+static const u8 sText_AbilitiesPage_InnateLabel[] = _("Innate");
+static const u8 sText_AbilitiesPage_EmptySlot[] = _("---");
+
+// Prints one label+name/description block into the given Abilities-page
+// window. If ability is ABILITY_NONE (an unused innate slot), prints a
+// placeholder instead of blank space so it's clear the slot is intentionally
+// empty rather than a rendering bug.
+static void PrintAbilitiesPageBlock(u8 dataWindowId, const u8 *label, enum Ability ability)
+{
+    u8 windowId = AddWindowFromTemplateList(sPageAbilitiesTemplate, dataWindowId);
+
+    PrintTextOnWindow(windowId, label, 0, 1, 0, 4);
+    if (ability == ABILITY_NONE)
+    {
+        PrintTextOnWindow(windowId, sText_AbilitiesPage_EmptySlot, 60, 1, 0, 1);
+        PrintTextOnWindow(windowId, sText_AbilitiesPage_EmptySlot, 0, 17, 0, 0);
+    }
+    else
+    {
+        PrintTextOnWindow(windowId, gAbilitiesInfo[ability].name, 60, 1, 0, 1);
+        PrintTextOnWindow(windowId, gAbilitiesInfo[ability].description, 0, 17, 0, 0);
+    }
+}
+
+static void PrintAbilitiesPageText(void)
+{
+    enum Species species = sMonSummaryScreen->summary.species;
+    enum Ability mainAbility = GetAbilityBySpecies(species, sMonSummaryScreen->summary.abilityNum);
+
+    PrintAbilitiesPageBlock(PSS_DATA_WINDOW_ABILITIES_MAIN, sText_AbilitiesPage_MainLabel, mainAbility);
+    PrintAbilitiesPageBlock(PSS_DATA_WINDOW_ABILITIES_INNATE1, sText_AbilitiesPage_InnateLabel, gSpeciesInfo[species].innates[0]);
+    PrintAbilitiesPageBlock(PSS_DATA_WINDOW_ABILITIES_INNATE2, sText_AbilitiesPage_InnateLabel, gSpeciesInfo[species].innates[1]);
+    PrintAbilitiesPageBlock(PSS_DATA_WINDOW_ABILITIES_INNATE3, sText_AbilitiesPage_InnateLabel, gSpeciesInfo[species].innates[2]);
+}
+
+static void Task_PrintAbilitiesPage(u8 taskId)
+{
+    enum Species species = sMonSummaryScreen->summary.species;
+    s16 *data = gTasks[taskId].data;
+
+    switch (data[0])
+    {
+    case 1:
+        PrintAbilitiesPageBlock(PSS_DATA_WINDOW_ABILITIES_MAIN, sText_AbilitiesPage_MainLabel,
+            GetAbilityBySpecies(species, sMonSummaryScreen->summary.abilityNum));
+        break;
+    case 2:
+        PrintAbilitiesPageBlock(PSS_DATA_WINDOW_ABILITIES_INNATE1, sText_AbilitiesPage_InnateLabel, gSpeciesInfo[species].innates[0]);
+        break;
+    case 3:
+        PrintAbilitiesPageBlock(PSS_DATA_WINDOW_ABILITIES_INNATE2, sText_AbilitiesPage_InnateLabel, gSpeciesInfo[species].innates[1]);
+        break;
+    case 4:
+        PrintAbilitiesPageBlock(PSS_DATA_WINDOW_ABILITIES_INNATE3, sText_AbilitiesPage_InnateLabel, gSpeciesInfo[species].innates[2]);
+        break;
+    case 5:
+        DestroyTask(taskId);
+        return;
+    }
+    data[0]++;
+}
